LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=your_livekit_api_key
LIVEKIT_API_SECRET=your_livekit_api_secret

# Provider selection. Adapters can be added without changing call/session APIs.
STT_PROVIDER=unconfigured
TRANSLATION_PROVIDER=unconfigured
TTS_PROVIDER=unconfigured

# Provider secrets belong only in server/Vercel environment variables.
SARVAM_API_KEY=
DEEPGRAM_API_KEY=
OPENAI_API_KEY=
ELEVENLABS_API_KEY=
GOOGLE_AI_API_KEY=
